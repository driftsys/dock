{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "fixture",
          "version": "1.0.0",
          "rules": [
            {
              "id": "fixture-rule",
              "shortDescription": {
                "text": "Fixture rule"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "fixture-rule",
          "level": "warning",
          "message": {
            "text": "UNCHANGED_FINDING"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fixture.sh"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "fixture-rule",
          "level": "warning",
          "message": {
            "text": "ADDED_FINDING"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fixture.sh"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
