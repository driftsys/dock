# syntax=docker/dockerfile:1
# hadolint ignore=DL3006
FROM dock-jvm

ARG VERSION=dev
ARG ANDROID_CMDLINE_TOOLS_VERSION=16111833
ARG ANDROID_BUILD_TOOLS_VERSION=37.0.0
ARG ANDROID_PLATFORM_VERSION=37.2

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Download and install Android command-line tools.
# The Linux archive bundles an x86-64 launcher. Google distributes the native
# arm64 launcher separately; both launchers download their current CLI payload.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p "${ANDROID_HOME}/cmdline-tools" \
 && curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" \
    -o /tmp/cmdline-tools.zip \
 && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools \
 && mv /tmp/cmdline-tools/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" \
 && rm -rf /tmp/cmdline-tools.zip /tmp/cmdline-tools \
 && if [ "$(dpkg --print-architecture)" = arm64 ]; then \
      curl -fsSL "https://dl.google.com/android/cli/latest/linux_arm64/android" \
        -o "${ANDROID_HOME}/cmdline-tools/latest/bin/android" \
      && chmod 0755 "${ANDROID_HOME}/cmdline-tools/latest/bin/android"; \
    fi

# Accept licenses and install SDK components
# Note: "yes" exits with SIGPIPE (141) when sdkmanager closes stdin;
# piping through "true" absorbs the non-zero exit under pipefail.
RUN yes 2>/dev/null | sdkmanager --licenses > /dev/null 2>&1 || true \
 && android --no-metrics sdk --platform=linux_x86_64 install \
    "platform-tools" \
    "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
    "platforms;android-${ANDROID_PLATFORM_VERSION}"

# Generate manifest
COPY scripts/manifest.sh /usr/local/bin/manifest.sh
RUN manifest.sh android "${VERSION}" \
    "cmdline-tools=${ANDROID_CMDLINE_TOOLS_VERSION}" \
    "build-tools=${ANDROID_BUILD_TOOLS_VERSION}" \
    "platform=${ANDROID_PLATFORM_VERSION}" \
    "adb:adb --version"
