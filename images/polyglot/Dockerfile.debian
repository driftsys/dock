# syntax=docker/dockerfile:1
ARG UV_VERSION=0.12.22
ARG RUFF_VERSION=0.16.10

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-bin
FROM ghcr.io/astral-sh/ruff:${RUFF_VERSION} AS ruff-bin

# hadolint ignore=DL3006
FROM dock-rust AS runtime

ARG VERSION=dev
# Deno release to install — keep in sync with images/deno/Dockerfile.debian
ARG DENO_VERSION=2.9.3
# Keep the distribution interpreter and pip for tools that still require pip.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
 && rm -rf /var/lib/apt/lists/*

# Copy pinned multiarch binaries without modifying distribution Python packages.
COPY --from=uv-bin /uv /uvx /usr/local/bin/
COPY --from=ruff-bin /ruff /usr/local/bin/

ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_SYSTEM_CERTS=true

# Install the official LTS binary; GitHub versioned releases use stable.
RUN DPKG_ARCH="$(dpkg --print-architecture)" && \
    case "$DPKG_ARCH" in \
      amd64)  DENO_ARCH="x86_64-unknown-linux-gnu" ;; \
      arm64)  DENO_ARCH="aarch64-unknown-linux-gnu" ;; \
      *)      echo "unsupported arch: $DPKG_ARCH" && exit 1 ;; \
    esac && \
    curl -sSfL \
      "https://dl.deno.land/release/v${DENO_VERSION}/deno-${DENO_ARCH}.zip" \
      -o /tmp/deno.zip && \
    unzip -q /tmp/deno.zip -d /usr/local/bin && \
    rm /tmp/deno.zip && \
    chmod +x /usr/local/bin/deno && \
    deno --version

# Point Deno and pip at the system CA bundle for corporate CA support.
# CARGO_HTTP_CAINFO is inherited from :rust; core ENVs from :core.
ENV DENO_CERT=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# Generate manifest
COPY scripts/manifest.sh /usr/local/bin/manifest.sh
RUN manifest.sh polyglot "${VERSION}" "python3:python3 --version" "pip3:pip3 --version" "ruff:ruff --version" "uv:uv --version" "deno:deno --version"
