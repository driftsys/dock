# syntax=docker/dockerfile:1
ARG UV_VERSION=0.12.22
ARG RUFF_VERSION=0.16.10

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-bin
FROM ghcr.io/astral-sh/ruff:${RUFF_VERSION} AS ruff-bin

# hadolint ignore=DL3006
FROM dock-core AS runtime

ARG VERSION=dev
# Keep the distribution interpreter and pip for tools that still require pip.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
 && rm -rf /var/lib/apt/lists/*

# Copy pinned multiarch binaries without modifying distribution Python packages.
COPY --from=uv-bin /uv /uvx /usr/local/bin/
COPY --from=ruff-bin /ruff /usr/local/bin/

ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_SYSTEM_CERTS=true

# Point pip at the system CA bundle for corporate CA support.
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# Generate manifest
COPY scripts/manifest.sh /usr/local/bin/manifest.sh
RUN manifest.sh python "${VERSION}" "python3:python3 --version" "pip3:pip3 --version" "ruff:ruff --version" "uv:uv --version"
